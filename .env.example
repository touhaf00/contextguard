# Copy this file to .env.local and replace the placeholders. .env.local is ignored by Git.

COMINTY_API_KEY=your_cominty_api_key
COMINTY_USER_ID=your_cominty_user_id
COMINTY_WORKER_AGENT_ID=your_worker_agent_id
COMINTY_GUARD_AGENT_ID=your_guard_agent_id

CONTEXTGUARD_GITHUB_APP_CLIENT_ID=your_github_app_client_id
CONTEXTGUARD_GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret
CONTEXTGUARD_GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/ui/github/callback
CONTEXTGUARD_GITHUB_APP_SLUG=your-github-app-slug

CONTEXTGUARD_UI_LOCAL_SESSION_ENABLED=false
CONTEXTGUARD_UI_REAL_EXECUTION_ENABLED=false
